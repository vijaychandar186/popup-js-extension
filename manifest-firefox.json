{
  "manifest_version": 3,
  "name": "Wellness Monitor",
  "version": "1.0.0",
  "description": "AI-powered eye strain and posture monitoring for healthier screen habits",
  "permissions": [
    "storage",
    "notifications",
    "windows",
    "alarms",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/favicon-16x16.png",
      "32": "assets/favicon-32x32.png",
      "48": "assets/favicon-32x32.png",
      "128": "assets/android-chrome-192x192.png"
    }
  },
  "icons": {
    "16": "assets/favicon-16x16.png",
    "32": "assets/favicon-32x32.png",
    "48": "assets/favicon-32x32.png",
    "128": "assets/android-chrome-192x192.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/sounds/*.mp3",
        "assets/*.png",
        "assets/*.ico",
        "libs/*",
        "static/css/*",
        "static/js/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wellness-monitor@example.com",
      "strict_min_version": "109.0"
    }
  }
}
